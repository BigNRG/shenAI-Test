// Copy this file to Secrets.xcconfig (git-ignored) and fill in your values.
// All values are optional: the API key can also be pasted in the app.

// Your Shen.AI iOS API key from https://developer.shen.ai
// NOTE: in .xcconfig files "//" starts a comment, so keys containing "//" must be escaped as "/$()/".
SHENAI_API_KEY = your-api-key

// Your Apple developer team ID (Xcode > Settings > Accounts) and a unique bundle id.
DEVELOPMENT_TEAM = ABCDE12345
PRODUCT_BUNDLE_IDENTIFIER = com.yourname.shenaitest
