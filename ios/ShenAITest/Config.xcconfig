// Shared build settings for the Shen.AI test app.
// Personal values (API key, signing team, bundle id) go in Secrets.xcconfig,
// which is git-ignored. Copy Secrets.example.xcconfig to Secrets.xcconfig.

SHENAI_API_KEY =
SHENAI_SDK_VERSION = 3.1.14
DEVELOPMENT_TEAM =
PRODUCT_BUNDLE_IDENTIFIER = com.example.shenaitest

#include? "Secrets.xcconfig"
